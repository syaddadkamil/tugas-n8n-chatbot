    {
      "parameters": {
        "jsCode": "// Kosongkan untuk memakai tanggal hari ini. Untuk TES dengan data April 2026, isi: '2026-04-19'\nconst REF_DATE = '';\n\nconst DAY = 24 * 60 * 60 * 1000;\nconst now = REF_DATE ? new Date(REF_DATE) : new Date();\nconst end = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());\nconst start = end - 6 * DAY; // 7 hari terakhir termasuk hari ini\n\nfunction parseDate(v) {\n  if (v === undefined || v === null || v === '') return null;\n  if (typeof v === 'number') return new Date(Math.round((v - 25569) * DAY)); // serial Sheets\n  const s = String(v).trim();\n  const m = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/); // dd/mm/yyyy\n  if (m) return new Date(Date.UTC(+m[3], +m[2] - 1, +m[1]));\n  const d = new Date(s);\n  return isNaN(d) ? null : d;\n}\nconst rp = n => 'Rp' + Number(n).toLocaleString('id-ID');\n\nconst data = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const d = parseDate(r['Tanggal']);\n  if (!d) continue;\n  const t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());\n  if (t < start || t > end) continue;\n  data.push({\n    tanggal: String(r['Tanggal']),\n    kategori: r['Kategori'],\n    deskripsi: r['Deskripsi'],\n    metode: r['Metode Pembayaran'],\n    jumlah: Number(String(r['Jumlah (IDR)']).replace(/[^0-9.-]/g, '')) || 0,\n    penerima: r['Penerima'],\n  });\n}\n\nconst total = data.reduce((a, b) => a + b.jumlah, 0);\nconst dataTeks = data\n  .map(x => `- ${x.tanggal} | ${x.kategori} | ${x.deskripsi} | ${x.metode} | ${rp(x.jumlah)} | ${x.penerima}`)\n  .join('\\n');\n\nreturn [{ json: {\n  jumlahTransaksi: data.length,\n  totalPengeluaran: total,\n  periode: `${new Date(start).toISOString().slice(0,10)} s/d ${new Date(end).toISOString().slice(0,10)}`,\n  dataTeks,\n  data,\n}}];"
      },
